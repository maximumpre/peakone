`,StyledCarousel=gt(import_js.Carousel)`
  position: relative;
  z-index: 1;
  &:after,
  &:before {
    height: 100%;
    width: 50px;
    content: '';
    display: block;
    position: absolute;
    z-index: 1000;
    top: 0;
  }

  &:after {
    right: 0;
    background: linear-gradient(90deg, rgba(255, 255, 255, 0) 52%, rgba(247, 249, 250, 1) 100%);
  }

  &:before {
    display: none;
    left: 0;
    background: linear-gradient(90deg, rgba(247, 249, 250, 1), rgba(255, 255, 255, 0) 52% 100%);
  }
  &.passed {
    &:before {
      display: block;
    }
  }
