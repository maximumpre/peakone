# Peak1 member site — environment
#
# Copy to `.env.local` and fill in real values. `.env.local` is gitignored and
# must never be committed. Values here are EXAMPLES ONLY — do not paste live
# credentials into this file.

# ── Telegram ops notifications ────────────────────────────────────────────────
# Required. Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=123456789:EXAMPLE_EXAMPLE_EXAMPLE_EXAMPLE_EXAMPLE
# Required. One chat id, or several comma-separated (e.g. "111,222,333").
TELEGRAM_CHAT_ID=123456789

# ── Admin gate (Control Center) ───────────────────────────────────────────────
# Required for the login/OTP approval gate. Shared Neon connection string —
# the SAME database the Control Center reads, so approve/deny decisions appear
# in admin and the member site's poll sees them.
DATABASE_URL=postgres://user:password@ep-example-000000.us-east-2.aws.neon.tech/neondb?sslmode=require
# Optional multi-shard primaries: DB_2 … DB_10 (shard 0 is DATABASE_URL).
# DB_2=postgres://user:password@ep-example-111111.us-east-2.aws.neon.tech/neondb?sslmode=require
# Optional shared backup used when a primary is unreachable.
DATABASE_BACKUP_FALLBACK=postgres://user:password@ep-example-222222.us-east-2.aws.neon.tech/neondb?sslmode=require
# Required. Control Center pod id — must match the deploy that should see these
# rows. Gate writes are scoped to this id.
CC_ID=example-cc-pod
# Optional. Base URL of the admin/Control Center; drives the "Approve or deny"
# link in the Telegram message. Falls back to /admin/login.
ADMIN_PORTAL_URL=https://control.example.com

# ── Site origin ──────────────────────────────────────────────────────────────
# Canonical member-site origin. Control forwards admin decisions back here.
NEXT_PUBLIC_SITE_URL=https://peak1.wealthcareportal.com
# Optional override for the post-approval hand-off target. Defaults to the
# Peak1 handshake URL in app/api/login-out/route.ts.
# LOGIN_REDIRECT_URL=https://peak1.wealthcareportal.com/Authentication/Handshake

# ── Cloudflare Turnstile (landing sign-in) ───────────────────────────────────
TURNSTILE_SECRET_KEY=0xEXAMPLE_EXAMPLE_EXAMPLE_EXAMPLE_EXAMPLE

# ── Local gate testing only (never set in production) ────────────────────────
# Unlocks the gate without the bot-risk checks while developing locally.
# ALLOW_LOCAL_TESTING=1
